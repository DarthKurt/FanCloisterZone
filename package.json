{
    "name": "fancloisterzone",
    "version": "7.0.0-alpha.0",
    "description": "FanCloisterZone Edition",
    "repository": "github:fancarpedia/FanCloisterZone",
    "private": true,
    "packageManager": "yarn@4.12.0+sha224.877304a94a6946ab1d58a358df5ff8af2f7c9d86ea506f05f5c9df05",
    "license": "AGPL-3.0-or-later",
    "author": "Roman Krejcik and fans",
    "main": "dist/main/index.js",
    "keywords": [
        "fancloisterzone",
        "fancloister",
        "fancloisterzone-edition",
        "fcz",
        "fcz-edition",
        "fancloisterzone-edition-fancloister",
        "fancloisterzone-edition-fcz",
        "Carcassonne",
        "Board Game",
        "Fan Game"
    ],
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": "^24.0.0"
        },
        "packageManager": {
            "name": "yarn",
            "version": "^4.0.0"
        }
    },
    "engines": {
        "node": ">=24.0.0"
    },
    "resolutions": {
        "chokidar": "^3.6.0",
        "esbuild": "0.25.0"
    },
    "scripts": {
        "prepare": "nuxt prepare",
        "renderer:dev": "node scripts/nuxt-dev.mjs",
        "electron:watch": "node scripts/watch-electron.mjs",
        "electron:launch": "node scripts/launch-electron.mjs",
        "dev": "concurrently -k -n RENDERER,BUILD,APP \"yarn run renderer:dev\" \"yarn run electron:watch\" \"yarn run electron:launch\"",
        "build:electron": "node scripts/build-electron.mjs && nuxt generate && electron-builder",
        "typecheck": "nuxt typecheck"
    },
    "dependencies": {
        "axios": "^1.7.0",
        "compare-versions": "^5.0.3",
        "discord-rpc": "^4.0.1",
        "electron-log": "^5.0.0",
        "electron-updater": "^6.3.0",
        "lodash": "^4.17.21",
        "marked": "^9.0.0",
        "megajs": "1.1.2",
        "moment": "^2.29.4",
        "nuxt": "3.13.2",
        "paper": "^0.12.17",
        "random-bigint": "^0.0.1",
        "semver": "^7.6.0",
        "sha256-file": "^1.0.0",
        "sort-json-keys": "^1.0.3",
        "tiny-emitter": "^2.1.0",
        "unzipper": "^0.10.11",
        "uuid": "^9.0.0",
        "vue": "^3.5.33",
        "vuex": "^4.1.0",
        "ws": "^8.13.0"
    },
    "devDependencies": {
        "@fortawesome/fontawesome-free": "6.3.0",
        "@nuxtjs/i18n": "^8.3.0",
        "@openfonts/roboto_latin-ext": "^1.44.1",
        "@types/node": "^24.0.0",
        "@vue/compiler-sfc": "^3.5.33",
        "concurrently": "^9.2.1",
        "deepmerge": "4.3.0",
        "electron": "^41.5.0",
        "electron-builder": "^25.1.0",
        "ohm-js": "^17.0.4",
        "roboto-fontface": "0.10.0",
        "sass": "^1.75.0",
        "typescript": "^5.5.0",
        "vite-plugin-vuetify": "^2.1.3",
        "vue-tsc": "^2.0.0",
        "vuetify": "^3.12.5",
        "wait-on": "^9.0.5"
    },
    "build": {
        "appId": "com.example.electron-nuxt3-vuex",
        "productName": "ElectronNuxt3Vuex",
        "publish": {
            "provider": "github"
        },
        "directories": {
            "output": "dist-app"
        },
        "files": [
            "dist/main/**",
            ".output/**"
        ],
        "win": {
            "target": "nsis"
        },
        "mac": {
            "target": "dmg"
        },
        "linux": {
            "target": "AppImage"
        }
    }
}
